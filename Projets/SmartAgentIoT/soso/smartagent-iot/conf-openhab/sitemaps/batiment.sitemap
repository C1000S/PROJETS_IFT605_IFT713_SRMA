sitemap batiment label="SmartAgent-IoT : étage du bâtiment" {
    Frame label="Salle A" {
        Text item=SalleA_Temperature
        Text item=SalleA_Luminosite
        Text item=SalleA_Occupation
        Setpoint item=SalleA_Thermostat minValue=15 maxValue=30 step=0.5
    }
    Frame label="Salle B" {
        Text item=SalleB_Temperature
        Text item=SalleB_Luminosite
        Text item=SalleB_Occupation
        Setpoint item=SalleB_Thermostat minValue=15 maxValue=30 step=0.5
    }
    Frame label="Cuisine" {
        Text item=Cuisine_Temperature
        Text item=Cuisine_Luminosite
        Text item=Cuisine_Occupation
        Setpoint item=Cuisine_Thermostat minValue=15 maxValue=30 step=0.5
    }
    Frame label="Système" {
        Text item=Batiment_EtatAgents
        Text item=Batiment_DernierEquilibrage
        Text item=Alerte_Batiment
    }
}
