// batiment.items — Tâche 1.2 (+ Tâche 3.1 : métadonnée "expire")
//                 (+ modèle sémantique pour la Main UI — vu en cours)
//
// Concept : un Item est la variable manipulable par l'UI et les règles.
// Chaque Item est "lié" (binding) à exactement un canal du Thing correspondant
// via { channel="..." }.
//
// MODÈLE SÉMANTIQUE (les "tags" entre crochets) — c'est ce qui transforme la
// Main UI, vide avec de simples Items, en un tableau de bord riche généré
// automatiquement (cartes de pièces/équipements, icônes, graphiques au clic).
// On suit la hiérarchie canonique vue en cours :
//
//        Location (pièce)  ->  Equipment (équipement)  ->  Point (mesure/consigne)
//        gSalleA [Room]        gSalleA_Capteurs [Sensor]    SalleA_Temperature ...
//                              gSalleA_Thermostat [Radiator] SalleA_Thermostat ...
//
//   - Location  : une PIÈCE ["Room"] ; les pièces sont dans le bâtiment ["Building"].
//   - Equipment : un dispositif ["Sensor"] (les 3 capteurs) / ["RadiatorControl"]
//                 (le thermostat) ; il appartient à une pièce.
//   - Point     : à quoi sert l'Item ["Measurement"|"Setpoint"|"Status"]
//   - Property  : sur quoi il porte "Temperature" / "Light" / "Presence".
//
// Tâche 3.1 — métadonnée "expire" sur les 3 Items de CAPTEUR (pas le thermostat,
// qui est une consigne que NOUS envoyons) : sans mise à jour pendant 30s,
// openHAB force l'état à UNDEF automatiquement. ATTENTION : "expire" est une
// MÉTADONNÉE d'Item (namespace expire=...), pas un "profile" de lien de canal —
// il n'existe aucun profile nommé "expire". On écrit donc bien
// { channel="...", expire="30s,state=UNDEF" } et surtout PAS profile="expire".

// ============================================================================
//  Niveau 1 — Localisations : Bâtiment > Pièces
// ============================================================================
Group  gBatiment  "Bâtiment"  <house>    ["Building"]

Group  gSalleA    "Salle A"   <office>   (gBatiment)  ["Room"]
Group  gSalleB    "Salle B"   <office>   (gBatiment)  ["Room"]
Group  gCuisine   "Cuisine"   <kitchen>  (gBatiment)  ["Room"]

// ============================================================================
//  Niveau 2 — Équipements par pièce (capteurs + thermostat)
// ============================================================================
Group  gSalleA_Capteurs   "Capteurs"   <motion>    (gSalleA)   ["Sensor"]
Group  gSalleA_Thermostat "Thermostat" <radiator>  (gSalleA)   ["RadiatorControl"]
Group  gSalleB_Capteurs   "Capteurs"   <motion>    (gSalleB)   ["Sensor"]
Group  gSalleB_Thermostat "Thermostat" <radiator>  (gSalleB)   ["RadiatorControl"]
Group  gCuisine_Capteurs  "Capteurs"   <motion>    (gCuisine)  ["Sensor"]
Group  gCuisine_Thermostat "Thermostat" <radiator> (gCuisine)  ["RadiatorControl"]

// ============================================================================
//  Niveau 3 — Points (rattachés à leur équipement, pas directement à la pièce)
// ============================================================================

// --- Salle A ---
Number  SalleA_Temperature  "Température [%.1f °C]"  <temperature>  (gSalleA_Capteurs)    ["Measurement","Temperature"]  { channel="mqtt:topic:salleA:temperature", expire="30s,state=UNDEF" }
Number  SalleA_Luminosite   "Luminosité [%d lux]"    <light>        (gSalleA_Capteurs)    ["Measurement","Light"]        { channel="mqtt:topic:salleA:luminosite",  expire="30s,state=UNDEF" }
Switch  SalleA_Occupation   "Occupée"                <presence>     (gSalleA_Capteurs)    ["Status","Presence"]          { channel="mqtt:topic:salleA:occupation",  expire="30s,state=UNDEF" }
Number  SalleA_Thermostat   "Consigne [%.1f °C]"     <heating>      (gSalleA_Thermostat)  ["Setpoint","Temperature"]     { channel="mqtt:topic:salleA:thermostat" }

// --- Salle B ---
Number  SalleB_Temperature  "Température [%.1f °C]"  <temperature>  (gSalleB_Capteurs)    ["Measurement","Temperature"]  { channel="mqtt:topic:salleB:temperature", expire="30s,state=UNDEF" }
Number  SalleB_Luminosite   "Luminosité [%d lux]"    <light>        (gSalleB_Capteurs)    ["Measurement","Light"]        { channel="mqtt:topic:salleB:luminosite",  expire="30s,state=UNDEF" }
Switch  SalleB_Occupation   "Occupée"                <presence>     (gSalleB_Capteurs)    ["Status","Presence"]          { channel="mqtt:topic:salleB:occupation",  expire="30s,state=UNDEF" }
Number  SalleB_Thermostat   "Consigne [%.1f °C]"     <heating>      (gSalleB_Thermostat)  ["Setpoint","Temperature"]     { channel="mqtt:topic:salleB:thermostat" }

// --- Cuisine ---
Number  Cuisine_Temperature "Température [%.1f °C]"  <temperature>  (gCuisine_Capteurs)   ["Measurement","Temperature"]  { channel="mqtt:topic:cuisine:temperature", expire="30s,state=UNDEF" }
Number  Cuisine_Luminosite  "Luminosité [%d lux]"    <light>        (gCuisine_Capteurs)   ["Measurement","Light"]        { channel="mqtt:topic:cuisine:luminosite",  expire="30s,state=UNDEF" }
Switch  Cuisine_Occupation  "Occupée"                <presence>     (gCuisine_Capteurs)   ["Status","Presence"]          { channel="mqtt:topic:cuisine:occupation",  expire="30s,state=UNDEF" }
Number  Cuisine_Thermostat  "Consigne [%.1f °C]"     <heating>      (gCuisine_Thermostat) ["Setpoint","Temperature"]     { channel="mqtt:topic:cuisine:thermostat" }

// ============================================================================
//  Supervision — Item piloté par le CoordinateurBatiment via l'API REST (S3)
// ============================================================================
// Item SANS canal MQTT : il n'est jamais alimenté par un capteur. C'est le
// CoordinateurBatiment (programme Java RMI) qui y pousse le résumé de sa
// dernière décision d'équilibrage par un POST REST openHAB
// (POST /rest/items/Batiment_Coordination). Son changement d'état déclenche la
// règle DSL "Coordination batiment" — c'est le pont coordinateur ↔ règles openHAB.
String  Batiment_Coordination  "Dernière décision du coordinateur [%s]"  <text>  (gBatiment)  ["Status"]
