# Build Maven
target/
*.class

# openHAB génère énormément de fichiers runtime dans userdata/ (cache, logs, kar,
# base de données de config UI) : on ne versionne QUE nos fichiers texte de conf
# (things/items/rules), pas l'état runtime.
openhab/userdata/
openhab/addons/*
!openhab/addons/.gitkeep

# Logs (y compris le dossier runtime créé par scripts/start-all.sh)
*.log
logs/

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS
.DS_Store
